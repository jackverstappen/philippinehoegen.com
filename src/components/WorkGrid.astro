---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import HexGrid from "../components/HexGrid.astro";
import { imageConfig } from "astro:assets";
import { undefined } from "astro:schema";

const {
  collection  = [],
  ...rest
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const mediaImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/works/**/*.{jpg,jpeg,png,webp,avif,gif}'
);

const tiles = await Promise.all(collection.map(async (p) => {
  let src = "";
  if (p.data.cover) {
    const loader = mediaImages[`/src/content/works/${p.id}/${p.data.cover.replace(/^\.\//, '')}`];
    if (loader) {
      const mod = await loader();
      const optimized = await getImage({ src: mod.default, width: 200 });
      src = optimized.src;
    }
  }
  return {
    id: `${p.id}`,
    href: `${base}/works/${p.id}`,
    src,
    alt: p.data.title ?? "",
    title: p.data.title ?? "",
    desc: p.data.desc,
    keywords: p.data.keywords,
    tags: p.data.tags,
  };
}));


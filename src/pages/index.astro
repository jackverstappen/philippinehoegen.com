---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Preloader from "../components/Preloader.astro";
import WorkCaption from "../components/WorkCaption.astro";
import WorkGrid from "../components/WorkGrid.astro";

const workCollection = await getCollection("works");
workCollection.sort((a, b) => {
  if (!a.data.period && !b.data.period) return a.data.title.localeCompare(b.data.title);
  if (!a.data.period) return 1;
  if (!b.data.period) return -1;
  return -a.data.period.start.localeCompare(b.data.period.start);
});

const recentWorks = workCollection.slice(0,5).map(n=>n.id);

// Read pinned order from the singleton YAML — one save = one deploy
const [pinnedData] = await getCollection("pinned");
const pinnedIds = pinnedData?.data.works ?? [];

const selection = [... new Set(recentWorks.concat(pinnedIds))]

console.log("recent",JSON.stringify(recentWorks));
console.log("pinned",JSON.stringify(pinnedData), JSON.stringify(pinnedIds));
console.log("selection",JSON.stringify(selection));


// Preserve the order defined in the singleton
const pinnedCollection = workCollection.filter((w) => selection.includes(w.id))
const allTags = [...new Set(
  workCollection.flatMap((work) => work.data.tags ?? [])
)].sort();
/*
const pinnedCollection = pinnedIds
  .map((id) => workCollection.find((w) => w.id === id))
  .filter((w) => w !== undefined);
const allTags = [...new Set(
  workCollection.flatMap((work) => work.data.tags ?? [])
)].sort();
*/

const updatesCollection = await getCollection("updates");

const dateOptions: object = {
	year: "numeric",
	month: "short",
	day: "numeric",
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const recentUpdates = updatesCollection
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 20);

const formatDate = (date) => new Date(date).toLocaleDateString("en-BE", dateOptions);
const expose = (rec) => `${formatDate(rec.pubDate)}`;


const title = "";
---

<BaseLayout title={title}>
  <!-- 
    The <Preloader /> component is used to preload all images on the homepage using the images.loaded.js script. 
    If you don’t want to use the preloader (e.g., for faster page load times or if you don’t require preloading images), you can safely remove the <Preloader /> component from this layout.
  -->
  <Preloader />
  <p>Recent and selected work  (for more visit the <a href={`${base}/works`}>Works</a> section): </p>
  <WorkCaption/>
  <WorkGrid collection={pinnedCollection} gap={4} borderWidth={1}/>
  <div class="block px-8 gap-8 md:grid md:auto-rows-fr md:grid-cols-2">
    <div class="mt-9 rounded-lg bg-surface border border-[1.5px] border-ink p-4" >
      <header class="title-header">
        <p class="block font-light">introduction</p>
        <h2>Philippine Hoegen</h2>
      </header>
      <p>Philippine Hoegen (she/her) is an artist and researcher based in Belgium and the Netherlands. Her practice focuses on performance both as an artistic medium and as a methodology for research. Through performance, she explores the shifting, constructed, and performed nature of the self, often working collaboratively and across disciplines. In recent years, her research has increasingly centered on the politics, visibility, and value of work, and on how performance can illuminate the embodied, relational, and often invisible dimensions of labour.</p>
      <p>Hoegen is currently a researcher and Professional Doctorate (PD) candidate at the  HKU (University of the Arts Utrecht). Her doctoral project, Performing Working, critically examines how the primacy of waged work as the measure of participation and citizenship, produces blind spots and social exclusion. She explores undervalued, hidden, and unwaged forms of labour and the socially ingrained mechanisms that render them invisible.</p>
      <p><i>“<b>THE PROBLEM WITH WORK</b> that this research addresses is that if we only acknowledge waged work as work, we marginalise all the many things we do, and must be done, that are equally laborious and no less – if not more – crucial to our wellbeing, survival and give meaning to being. Marginalising care work, maintenance work, community work, creative and recreational work, survival work, reproductive labour, grief work, time work, illness work to name just a few, means invisibilising those doing that work, excluding those workers from participation in society, and relegating that work to our 'after hours'. We are all those workers sometimes, a lot of the time or will be at some point in our lives. This work needs time, space and acknowledgement.”</i></p>
      <p>Follow the research Performing Working here: <a
          href="https://www.researchcatalogue.net/view/2550715/2550716"
          class="inline-block px-1 py-0.5 rounded-lg bg-black/20 border border-ink"
          rel="noopener"
          aria-label="Research Catalogue, opens in a new tab."
          target="_blank">https://www.researchcatalogue.net/view/2550715/2550716</a>
      </p>
      

    </div>
    <div class="mt-9 rounded-lg bg-surface border border-[1.5px] border-ink p-4">
      <header class="title-header">

      <p class="block font-light">upcoming and recent developments</p>
      <h2 class="" >News</h2>
      </header>
      <ul class="news-list list-none p-0 m-0" id="list">
        {recentUpdates.map((update) =>
          <li class="my-2 leading-snug">
            <a href={`${base}/news/${update.id}`}><b>{expose(update.data)}</b> - {update.data.title}</a>
          </li>
        )}
      </ul>

    </div>
</div>
  
</BaseLayout>
<style>
  p {
    margin-bottom:8px;
  }
  header > p {
    margin-bottom:0;
  }
</style>
<script src="../scripts/index.js"></script>
